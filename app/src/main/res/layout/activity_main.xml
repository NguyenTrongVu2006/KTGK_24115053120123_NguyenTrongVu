<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvTieuDe_123"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NHẬP THÔNG TIN KHOẢN CHI"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/edtTenKhoanChi_123"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tên khoản chi (ví dụ: Mua giáo trình C#)"
        android:minHeight="48dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/edtSoTien_123"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Số tiền (VNĐ)"
        android:inputType="numberDecimal"
        android:minHeight="48dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/edtGhiChu_123"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ghi chú thêm"
        android:minHeight="48dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnThemKhoanChi_123"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thêm khoản chi"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnXemChiTiet_123"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xem chi tiết khoản chi"
        android:backgroundTint="#4CAF50" />

</LinearLayout>